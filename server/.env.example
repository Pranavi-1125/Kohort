PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kohort

# Firebase Admin (use ONE of the options below)
# Option A: path to the service account JSON downloaded from Firebase console
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B: the whole JSON on one line (handy for hosting providers)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Needed for Realtime Database admin access (optional on server)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
